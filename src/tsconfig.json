{
    "compilerOptions": {
        "outDir": "../build/src",
        "rootDir": ".",
    },
    "extends": "../tsconfig.json",
    "include": [
        "**/*.ts",
        "genfiles/*.json",
    ],
    "exclude": [
      "client/**/*.ts",
      // Client parts of the optional extensions are bundled by Vite only
      "genfiles/extensionsClient.ts",
      "extensions/*/client/**/*.ts",
      "extensions/*/extension.client.ts"
    ]
}
